# =======================================================================
# STEP 8: FORECAST COMBINATION (ADAPTED FOR UNEMPLOYMENT DATA)
# =======================================================================
#
# ADAPTATION NOTE: Since strictly no models passed the 0.05 Ljung-Box threshold,
# we lower the bar to p > 0.001 to allow the best-performing models (like sarima210113)
# to be combined, preventing the code from breaking.
# =======================================================================
library(tidyverse)
library(fpp3)
# 1) Models that get closest to passing Ljung-Box at lag 24
valid_models <- augment(fit) %>%
features(.innov, ljung_box, lag = 24) %>%
filter(lb_pvalue > 0.001) %>%  # Ajustado de 0.05 para 0.001 para o código não falhar
pull(.model)
print("Models used for combination:")
print(valid_models)  # Verifica quais sobreviveram (deve aparecer o sarima210113)
# 2) In-sample RMSE weights (training set)
weights_rmse <- accuracy(fit) %>%
filter(.model %in% valid_models) %>%
mutate(w = (1/RMSE) / sum(1/RMSE)) %>%
select(.model, RMSE, w)
print("Model weights based on training RMSE:")
print(weights_rmse)
# 3) Combined point forecast — weighted average of individual forecasts
fc_combo_rmse <- fc %>%
filter(.model %in% valid_models) %>%
as_tibble() %>%
left_join(weights_rmse %>% select(.model, w), by = ".model") %>%
group_by(observation_date) %>%  # Adaptado para a sua variável de tempo
summarise(.mean = sum(w * .mean), .groups = "drop") %>%
mutate(.model = "combo_rmse")
# 4) Helper: out-of-sample RMSE for a combined forecast tibble
combo_metrics <- function(fc_combo, label) {
fc_combo %>%
inner_join(test_data %>% as_tibble(), by = "observation_date") %>% # Adaptado para test_data
summarise(
.model = label,
RMSE = sqrt(mean((UNRATE - .mean)^2)) # Adaptado para UNRATE
)
}
# Compare: individual models vs RMSE-weighted combination
print("Out-of-sample RMSE Comparison:")
bind_rows(
accuracy(fc, unemployment_ts) %>% select(.model, RMSE),
combo_metrics(fc_combo_rmse, "combo_rmse")
) %>%
arrange(RMSE)
# 5) Plot: individual valid-model forecasts + RMSE combination vs observed
cutoff_date <- min(test_data$observation_date)
ggplot() +
geom_line(data = unemployment_ts |> filter(observation_date >= cutoff_date - 24),
aes(x = observation_date, y = UNRATE), colour = "black", linewidth = 0.8) +
geom_line(data = fc %>% filter(.model %in% valid_models) %>% as_tibble(),
aes(x = observation_date, y = .mean, group = .model),
colour = "grey60", linewidth = 0.4, alpha = 0.7) +
geom_line(data = fc_combo_rmse,
aes(x = observation_date, y = .mean), colour = "firebrick", linewidth = 1) +
labs(title = "RMSE-weighted combination (red) vs individual models (grey) vs observed (black)",
y = "Unemployment Rate (%)", x = "Observation Date")
