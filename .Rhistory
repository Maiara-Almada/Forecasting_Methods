knitr::opts_chunk$set(echo = TRUE)
if (!require("tidyverse")) install.packages("tidyverse", repos = "https://cran.rstudio.com/")
if (!require("tsibble")) install.packages("tsibble", repos = "https://cran.rstudio.com/")
if (!require("fable")) install.packages("fable", repos = "https://cran.rstudio.com/")
if (!require("feasts")) install.packages("feasts", repos = "https://cran.rstudio.com/")
if (!require("urca")) install.packages("urca", repos = "https://cran.rstudio.com/")
if (!require("patchwork")) install.packages("patchwork", repos = "https://cran.rstudio.com/")
library(tidyverse)
library(tsibble)
library(fable)
library(feasts)
library(urca)
library(lubridate)
library(patchwork)
library(ggtime)
# Loading and transforming the data into a tsibble
unemployment_ts <- read.csv("UNRATE.csv") %>%
mutate(observation_date = yearmonth(observation_date)) %>%
as_tsibble(index = observation_date)
# 1. Clean the entire dataset first (Fill implicit holes and explicit NAs)
unemployment_ts %>%
autoplot(UNRATE)
# 2. Split into Training Data (All data prior to January 2019)
train_data <- unemployment_ts %>%
filter(year(observation_date) < 2018)
# 3. Split into Test Data (Exactly the year 2019)
# Method A: Using exact date boundaries
test_data <- unemployment_ts %>%
filter(year(observation_date) > 2018 & year(observation_date) < 2020)
# Alternative Method B (Cleaner): Using lubridate's year() function
# test_data <- unemployment_clean %>% filter(year(observation_date) == 2019)
# Visualizing the Unemployment Rate series
train_data %>%
autoplot(UNRATE) +
labs(title = "US Civilian Unemployment Rate (Monthly)",
subtitle = "Source: FRED",
y = "Unemployment Rate (%)",
x = "Year") +
theme_minimal()
train_data %>%
gg_tsdisplay(UNRATE, plot_type='partial')
# ADF test: Type = "drift"
adf_drift <- ur.df(train_data $UNRATE,
type = "drift",
lags=24)
summary(adf_drift)
# 1. Criar o dataset com a variável diferenciada
# Isto sim, é uma diferenciação sazonal (ex: lag = 12 para dados mensais)
diff_sazonal_data <- train_data %>%
mutate(UNRATE_seasonal_diff = difference(UNRATE, lag = 12))
# 2. Plotar a ACF e PACF da série diferenciada
diff_sazonal_data %>%
gg_tsdisplay(UNRATE_seasonal_diff, plot_type = 'partial', lag_max = 40)
# ADF test: Type = "drift"
adf_drift_diff <- ur.df(diff_sazonal_data $UNRATE,
type = "drift",
lags=12)
summary(adf_drift_diff)
# 1. Apply a seasonal difference (lag 12) AND an ordinary difference (lag 1)
double_diff_data <- diff_sazonal_data %>%
mutate(UNRATE_double_diff = difference(difference(UNRATE, lag = 12)))
# 2. Plot the new ACF and PACF up to lag 40
double_diff_data %>%
gg_tsdisplay(UNRATE_double_diff, plot_type = 'partial', lag_max = 40)
adf_drift_diff2 <- ur.df(double_diff_data$UNRATE,
type = "drift",
lags = 12)
summary(adf_drift_diff2)
adf_drift_diff2 <- ur.df(double_diff_data $UNRATE,
type = "drift",
selectlags='AIC', lags=12)
summary(adf_drift_diff2)
fit <- train_data %>%
model(
sarima111113 = ARIMA(UNRATE ~ pdq(1, 1, 1) + PDQ(1, 1, 3)),
sarima110113 = ARIMA(UNRATE ~ pdq(1, 1, 0) + PDQ(1, 1, 3)),
sarima111111 = ARIMA(UNRATE ~ pdq(1, 1, 1) + PDQ(1, 1, 1)),
sarima210113 = ARIMA(UNRATE ~ pdq(2, 1, 0) + PDQ(1, 1, 3)),
)
# Show names and orders of the estimated models
fit %>%
pivot_longer(everything(), names_to = "Model name", values_to = "Orders")
# Information criteria — pick the model with the lowest AICc
glance(fit) %>%
arrange(AICc) %>%
select(.model, sigma2, log_lik, AIC, AICc, BIC)
# Coefficients of all models (estimate, s.e., t-ratio, p-value)
tidy(fit) %>%
select(.model, term, estimate, std.error, statistic, p.value) %>%
arrange(.model, term)
# Full report for each model (coefs + sigma^2 + AIC/AICc/BIC + log-lik)
for (m in names(fit)) {
cat("\n============================================================\n",
m, "\n============================================================\n", sep = "")
fit %>% select(all_of(m)) %>% report()
}
fit %>% select(sarima111113) %>%
gg_tsresiduals(lag_max = 36)
fit %>% select(sarima110113) %>%
gg_tsresiduals(lag_max = 36)
fit %>% select(sarima111111) %>%
gg_tsresiduals(lag_max = 36)
fit %>% select(sarima210113) %>%
gg_tsresiduals(lag_max = 36)
augment(fit) %>%
features(.innov, ljung_box, lag = 36, dof = 6) %>%
arrange(desc(lb_pvalue))
augment(fit) %>%
features(.innov, box_pierce, lag = 36) %>%
arrange(bp_pvalue)
# -----------------------------------------------------------------------
# -----------------------------------------------------------------------
# 6'. IN-SAMPLE FORECAST (fitted values) AND FIT ERRORS
# -----------------------------------------------------------------------
#
# In-sample: compare fitted values with the observed values in the
# training period. Residuals are y_t - ŷ_t (1-step-ahead).
# -----------------------------------------------------------------------
# 1. Extrair os valores estimados (.fitted) e os erros para os seus modelos
# Ajustar APENAS o modelo vencedor nos dados de treino
fit_final <- train_data %>%
model(sarima210113 = ARIMA(UNRATE ~ pdq(2, 1, 0) + PDQ(1, 1, 3)))
aug <- augment(fit_final)
# Ajustar apenas o modelo vencedor nos dados de treino
fit_final <- train_data %>%
model(sarima210113 = ARIMA(UNRATE ~ pdq(2, 1, 0) + PDQ(1, 1, 3)))
# Extrair os valores estimados (.fitted) e os erros
aug_final <- augment(fit_final)
# Plot: Valores reais (Preto) vs Valores Estimados pelo modelo final
aug_final %>%
ggplot(aes(x = observation_date)) +
geom_line(aes(y = UNRATE), colour = "black", linewidth = 0.6) +
geom_line(aes(y = .fitted), colour = "steelblue", alpha = 0.8) +
labs(title = "In-sample fit: Observed (black) vs Fitted by SARIMA(2,1,0)(1,0,1)",
y = "Unemployment Rate (%)", x = "Observation Date")
# Métricas de Erro Dentro da Amostra (Training Accuracy)
accuracy(fit_final) %>%
select(.model, RMSE, MAE, MAPE, MASE)
# 4. Tabela de Métricas de Erro (Ordenada do modelo com menos erro para o pior)
accuracy(fit) %>%
select(.model, RMSE, MAE, MAPE, MASE) %>%
arrange(RMSE)
# -----------------------------------------------------------------------
# 7'. OUT-OF-SAMPLE FORECAST AND FORECAST ERRORS
# -----------------------------------------------------------------------
#
# Out-of-sample: forecast the periods in the test set and compare
# with the observed values that were NOT used for estimation.
# -----------------------------------------------------------------------
# 1. Gerar as previsões fora da amostra usando o seu 'test_data'
fc <- fit |>
forecast(new_data = test_data) # ← MUDADO AQUI PARA test_data
# 2. Gráfico Geral: Todos os modelos sobrepostos na série completa (sem intervalos)
fc %>%
autoplot(unemployment_ts, level = NULL) +
labs(title = "Unemployment Rate: Out-of-sample forecasts overlaid",
y = "Unemployment Rate (%)", x = "Observation Date", colour = "Model")
# 3. Zoom no período de teste com intervalos de previsão (um modelo por painel)
cutoff_date <- min(test_data$observation_date) # ← MUDADO AQUI PARA test_data
fc %>%
autoplot(unemployment_ts |> filter(observation_date >= cutoff_date - 24)) +
facet_wrap(~ .model, ncol = 2) +
labs(title = "Unemployment Rate: Out-of-sample forecast by model with intervals",
y = "Unemployment Rate (%)", x = "Observation Date")
# 4. Métricas de Precisão Fora da Amostra (Test Accuracy)
accuracy(fc, unemployment_ts) %>%
select(.model, RMSE, MAE, MAPE, MASE) %>%
arrange(RMSE)
# 5. Comparação Direta: Dentro vs Fora da Amostra
bind_rows(
accuracy(fit)                 %>% mutate(Type = "In-sample"),
accuracy(fc, unemployment_ts) %>% mutate(Type = "Out-of-sample")
) %>%
select(Type, .model, RMSE, MAE, MAPE, MASE) %>%
arrange(Type, RMSE)
accuracy(fit_final) %>%
select(.model, RMSE, MAE, MAPE, MASE) %>%
arrange(RMSE)
